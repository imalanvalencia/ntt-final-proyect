{
  "name": "banco-online-workspace",
  "version": "1.0.0",
  "description": "Workspace para el proyecto full-stack de Banco Online (NTT Dual)",
  "scripts": {
    "install:all": "npm install --prefix frontend",
    "start:frontend": "npm start --prefix frontend",
    "start:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
